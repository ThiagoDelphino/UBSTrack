# Copie este arquivo para .env (sem o .example) e troque as senhas.
# O .env NUNCA vai para o GitHub (está no .gitignore).
# Use só letras, números e _ nas senhas: elas entram dentro de URLs.

# Usuário administrador do banco (cria tabelas; usado só pelas migrations)
POSTGRES_USER=ubstrack
POSTGRES_PASSWORD=troque_esta_senha
POSTGRES_DB=ubstrack

# Senhas dos usuários de banco de cada API (criados pela migration de roles)
PAINEL_DB_PASSWORD=troque_senha_painel
SIMULADOR_DB_PASSWORD=troque_senha_simulador
